{
  "profile": "archive",
  "output_dir_name": "PROJECT_CONTEXT_EXPORTS",
  "include_extensions": [
    ".bat",
    ".c",
    ".cfg",
    ".cpp",
    ".cs",
    ".css",
    ".csv",
    ".dockerignore",
    ".env.example",
    ".gitignore",
    ".go",
    ".h",
    ".hpp",
    ".html",
    ".ini",
    ".java",
    ".js",
    ".json",
    ".jsx",
    ".kt",
    ".kts",
    ".lock",
    ".log",
    ".lua",
    ".m",
    ".md",
    ".mm",
    ".php",
    ".pl",
    ".ps1",
    ".py",
    ".r",
    ".rb",
    ".rs",
    ".rst",
    ".sample",
    ".sh",
    ".sql",
    ".swift",
    ".template",
    ".toml",
    ".ts",
    ".tsx",
    ".txt",
    ".xml",
    ".yaml",
    ".yml"
  ],
  "exclude_dirs": [
    ".git",
    ".idea",
    ".mypy_cache",
    ".pytest_cache",
    ".venv",
    ".vscode",
    "PROJECT_CONTEXT_EXPORTS",
    "__pycache__",
    "build",
    "dist",
    "env",
    "node_modules",
    "updates",
    "venv"
  ],
  "exclude_files": [
    ".env",
    ".env.development",
    ".env.local",
    ".env.production",
    ".env.test",
    "PROJECT_CONTEXT.md",
    "PROJECT_CONTEXT_SETTINGS.json",
    "PROJECT_MANIFEST.json",
    "PROJECT_SNAPSHOT.zip",
    "PROJECT_SUMMARY.txt",
    "app_settings.json",
    "build_history.json",
    "custom_profiles.json",
    "last_export_settings.json"
  ],
  "exclude_suffixes": [
    ".7z",
    ".crt",
    ".db",
    ".dll",
    ".dylib",
    ".exe",
    ".gif",
    ".ico",
    ".jpeg",
    ".jpg",
    ".key",
    ".p12",
    ".pdf",
    ".pem",
    ".pfx",
    ".png",
    ".rar",
    ".so",
    ".sqlite",
    ".webp",
    ".zip"
  ],
  "max_file_bytes": 2000000,
  "max_total_bytes": 100000000,
  "include_snapshot_zip": true,
  "redact_sensitive_lines": false,
  "include_hashes": true,
  "include_line_counts": true,
  "include_folder_tree": true,
  "include_file_index": true,
  "include_file_contents": true,
  "include_skipped_details": true,
  "timestamped_export_folder": true,
  "skipped_details_limit": 1000,
  "require_complete_source": true,
  "include_git_state": true,
  "git_state_commit_limit": 5
}