# --- OS / cloud-sync cruft ---
# macOS
.DS_Store
.DS_Store?
._*
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes
.TemporaryItems
.DocumentRevisions-V100
.fseventsd
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk
*.stackdump
*.cab
*.msi
*.msix
*.msm
*.msp

# Linux
# (*~ already covered by the Vim/Emacs backup-file pattern above)
.fuse_hidden*
.directory
.Trash-*
.nfs*

# --- Microsoft Office lock / owner files ---
~$*.doc
~$*.docx
~$*.xls
~$*.xlsx
~$*.ppt
~$*.pptx

# --- Temp / editor backups / merge leftovers ---
tmp/
temp/
*.tmp
*.temp
*.bak
*.orig
*.rej

# --- Secrets & credentials (never commit) ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
secrets.yml
secrets.json
.npmrc
.pypirc
.aws/credentials

# --- Logs (uncomment if your project should not track log files) ---
# logs/
# *.log

# --- Docker (opt-in, uncomment if this repo ships a Dockerfile) ---
# *.pid
# docker-compose.override.yml

# --- Terraform (opt-in, uncomment if this repo has Terraform configs) ---
# .terraform/
# *.tfstate
# *.tfstate.*
# *.tfvars
# crash.log

# --- Optional: binary assets (opt in per repo if a repo ships no assets) ---
# Left commented on purpose: some repos legitimately track screenshots,
# icons, or release archives, so blanket-ignoring them here would be wrong.
# Uncomment in the MASTER only if it should apply to every repo.
# *.zip
# *.7z
# *.rar
# *.exe
# *.dll
# *.so
# *.dylib

# ==========================================================================
# --- repo-specific ignores (not managed) ---
# Anything a repo needs beyond the shared block goes below this line --
# CanonSync will never touch it.
# ==========================================================================
